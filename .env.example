# Port on the host. Put Tally behind a reverse proxy with HTTPS before exposing it beyond your network.
TALLY_PORT=8000

# Signs the session cookie. Leave empty to generate one in the data volume, or set your own: openssl rand -hex 32
SECRET_KEY=

# Storage to create on first run: empty for none, "example" for the bundled sample, or a path to your own JSON layout.
TALLY_LAYOUT=
